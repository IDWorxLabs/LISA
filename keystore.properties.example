# Copy this file to:
#   %USERPROFILE%\LISA-Signing\keystore.properties
# (outside the Git repo) and fill in real values.
# Never commit keystore.properties, *.jks, or *.keystore.

storeFile=C:/path/to/your/lisa-upload-key.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
