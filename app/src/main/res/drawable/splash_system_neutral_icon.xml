<?xml version="1.0" encoding="utf-8"?>
<!--
  RC8.42 — Neutral system splash icon (fully transparent).
  Android 12+ requires a drawable in the animated-icon slot; this draws nothing so the
  user never sees a small centred LISA mark before the branded Compose splash.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="48dp"
        android:height="48dp" />
    <solid android:color="@android:color/transparent" />
</shape>
