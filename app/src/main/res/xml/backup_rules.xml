<?xml version="1.0" encoding="utf-8"?>
<!--
  LISA V1 — fullBackupContent (Android 11 / API ≤ 30).
  Cloud backup is also disabled via android:allowBackup="false".
  These excludes remain as defence-in-depth if backup is ever re-enabled.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="lisa_prefs.xml" />
    <exclude domain="sharedpref" path="lisa_secure_prefs.xml" />
    <exclude domain="sharedpref" path="lisa_secure_meta.xml" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
