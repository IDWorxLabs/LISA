<?xml version="1.0" encoding="utf-8"?>
<!--
  LISA V1 — dataExtractionRules (Android 12+ / API 31+).
  Cloud backup disabled via allowBackup=false; excludes protect cloud-backup and
  device-transfer extraction paths that honour these rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lisa_prefs.xml" />
        <exclude domain="sharedpref" path="lisa_secure_prefs.xml" />
        <exclude domain="sharedpref" path="lisa_secure_meta.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lisa_prefs.xml" />
        <exclude domain="sharedpref" path="lisa_secure_prefs.xml" />
        <exclude domain="sharedpref" path="lisa_secure_meta.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
